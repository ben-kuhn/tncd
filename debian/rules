#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	CGO_ENABLED=0 GOFLAGS=-mod=readonly go build \
	    -ldflags "-s -w -X github.com/ben-kuhn/tncd/v2/internal/version.Version=1.100-Beta" \
	    -o tncd ./cmd/tncd

override_dh_auto_test:
	# Skipped in packaging; run `go test ./...` in CI instead.

override_dh_auto_install:
	install -Dm755 tncd        $(CURDIR)/debian/tncd/usr/bin/tncd
	install -Dm644 tncd.ini    $(CURDIR)/debian/tncd/etc/tncd.ini.example
	# Patch service file for packaged install paths before installing.
	install -Dm644 /dev/null $(CURDIR)/debian/tncd/lib/systemd/system/tncd.service
	sed \
	    -e 's|ExecStart=.*tncd[^-].*|ExecStart=/usr/bin/tncd -c /etc/tncd.ini|' \
	    -e '/^WorkingDirectory=/d' \
	    tncd.service > $(CURDIR)/debian/tncd/lib/systemd/system/tncd.service
