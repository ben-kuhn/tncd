# Maintainer: KU0HN <ku0hn@ku0hn.radio>
pkgname=tncd
# The underscore is deliberate: Arch pkgver may not contain a hyphen, and the
# substitutions below turn it back into the real tag/dir name (v1.103-Beta).
pkgver=1.103_Beta
pkgrel=1
pkgdesc="AGWPE-to-KISS Translation Bridge"
arch=('x86_64' 'aarch64' 'armv7h' 'riscv64')
url="https://github.com/ben-kuhn/tncd"
license=('GPL-3.0-only')
makedepends=('go')
# The Go binary is fully static (CGO_ENABLED=0); no runtime depends.
source=("$pkgname-$pkgver.tar.gz::$url/archive/v${pkgver//_/-}.tar.gz")
sha256sums=('95b79bb79dd1219f80dd670844e5cae50f8317b4c8f35a4ebe52ab5938dc79ed')

build() {
    cd "$pkgname-${pkgver//_/-}"
    export CGO_ENABLED=0
    export GOFLAGS="-trimpath -mod=readonly -modcacherw"
    go build \
        -ldflags "-s -w -X github.com/ben-kuhn/tncd/v2/internal/version.Version=${pkgver//_/-}" \
        -o tncd \
        ./cmd/tncd
}

package() {
    cd "$pkgname-${pkgver//_/-}"
    install -Dm755 tncd                 "$pkgdir/usr/bin/tncd"
    install -Dm644 tncd.ini             "$pkgdir/etc/tncd.ini.example"
    # Install service file then patch ExecStart/WorkingDirectory for packaged paths.
    install -Dm644 tncd.service         "$pkgdir/usr/lib/systemd/system/tncd.service"
    sed -i \
        -e 's|ExecStart=.*tncd[^-].*|ExecStart=/usr/bin/tncd -c /etc/tncd.ini|' \
        -e '/^WorkingDirectory=/d' \
        "$pkgdir/usr/lib/systemd/system/tncd.service"
}
