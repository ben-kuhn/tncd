# Maintainer: Your Callsign <callsign@example.com>
pkgname=tncd
pkgver=0.11.1-BETA
pkgrel=1
pkgdesc="AGWPE-to-KISS Translation Bridge"
arch=('any')
url="https://github.com/ben-kuhn/tncd"
license=('GPL-3.0-only')
depends=('python' 'python-pyserial' 'python-kiss3' 'python-pyham-ax25' 'python-dbus' 'python-gobject')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('d468da6145f04ee008bfb2d03f829af9fe86fa770080649e8a09ef6dd4b68bc0')

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 tncd.py             "$pkgdir/usr/bin/tncd"
    install -Dm644 tncd.ini            "$pkgdir/etc/tncd.ini.example"
    # Install service files then patch ExecStart/WorkingDirectory for packaged paths.
    install -Dm644 tncd.service        "$pkgdir/usr/lib/systemd/system/tncd.service"
    sed -i \
        -e 's|ExecStart=.*tncd[^-].*|ExecStart=/usr/bin/tncd -c /etc/tncd.ini|' \
        -e '/^WorkingDirectory=/d' \
        "$pkgdir/usr/lib/systemd/system/tncd.service"
}
