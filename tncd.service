[Unit]
Description=AGWPE-to-KISS Translation Bridge
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
# Adjust User/Group to a dedicated service account or the user running the TNC.
# For Bluetooth, the user must be in the 'bluetooth' group.
User=nobody
Group=nobody

# tncd 2.0 is a single static Go binary. The .deb/.rpm packages install it at
# /usr/bin/tncd with config at /etc/tncd.ini (this ExecStart is patched to match
# at package build time); adjust the paths for a manual install.
ExecStart=/usr/bin/tncd -c /etc/tncd.ini
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
