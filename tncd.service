[Unit]
Description=AGWPE-to-KISS Translation Bridge
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
# Adjust User/Group to a dedicated service account or the user running the TNC.
# For Bluetooth, the user must be in the 'bluetooth' group.
User=nobody
Group=nobody
# Set to the directory containing tncd.py and tncd.ini.
WorkingDirectory=/opt/tncd

ExecStart=/usr/bin/python3 /opt/tncd/tncd.py -c /opt/tncd/tncd.ini
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
